# This config uses the headsOnly feature which will mirror the
# latest version of each channel within each package contained
# within a specified operator catalog
{% if oc_mirror_config.api_version == "v2" %}
{% if operators %}
---
apiVersion: mirror.openshift.io/v2alpha1
kind: ImageSetConfiguration
archiveSize: {{ archive_size }}
mirror:
  operators:
    - catalog: registry.redhat.io/redhat/certified-operator-index:v{{ olm_catalog_version }}
      packages:
{% for operator in desired_certified_operators %}
        - name: {{ operator.name }} 
{% endfor %}
{% if desired_certified_operators_additional_images %}
  additionalImages:
{% for additionalimages in desired_certified_operators_additional_images %}
    - name: {{ additionalimages.name }}
{% endfor %}
{% endif %}
{% endif %}
{% endif %}

